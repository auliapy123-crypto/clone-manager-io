# =====================================================================
# .gitignore ROOT — clone-manager-io
# Catatan: backend/ dan fe-accounting/ masing-masing SUDAH punya
# .gitignore sendiri untuk kebutuhan spesifiknya. File ini cuma
# menutup kebutuhan di folder yang belum punya .gitignore sendiri
# (backend-legacy-express) + jaring pengaman umum.
# =====================================================================

# backend-legacy-express (arsip lama, tidak pernah punya .gitignore sendiri)
backend-legacy-express/node_modules/
backend-legacy-express/.env

# Cache sementara TanStack Router di fe-accounting
fe-accounting/.tanstack/

# Bukti screenshot verifikasi GUI (artikel sesi testing, bukan bagian app)
gui-test-screenshots/

# File contoh uji manual (mis. .exe percobaan) -- TIDAK di-commit ke repo,
# dibuat ulang lewat perintah di panduan di bawah ini. Panduannya sendiri
# tetap di-track supaya bisa dibaca ulang sesi berikutnya.
uji-manual/*
!uji-manual/PANDUAN-UJI-ATTACHMENTS.md

# Jaring pengaman umum — node_modules di folder mana pun, kalau sampai
# ada folder baru lain nanti yang lupa dikasih .gitignore sendiri
**/node_modules/

# File sampah sistem operasi
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.aider*
start-ai-grid.bat