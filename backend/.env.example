# Salin file ini jadi ".env" (tanpa ".example"), lalu isi nilai aslinya.
# JANGAN PERNAH commit file ".env" ke Git (sudah ada di .gitignore).
# Semua nilai di bawah adalah PLACEHOLDER — tidak ada secret asli di sini.

# App
PORT=8014
NODE_ENV=development
LOG_LEVEL=debug
APP_PUBLIC_URL=http://localhost:8014

# Database
# Neon  : postgresql://<user>:<password>@<host>.aws.neon.tech/<db>?sslmode=require
# Lokal : postgresql://<user>:<password>@localhost:5432/<db>
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=<min-32-karakter>
JWT_SECRET_OLD=                       # opsional, secret lama saat rotasi
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<min-32-karakter>
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=<64-hex-32-byte>       # openssl rand -hex 32
BCRYPT_ROUNDS=10
BCRYPT_POOL_MIN=1
BCRYPT_POOL_MAX=4

# Integrasi
CORS_ORIGIN=http://localhost:5173
RABBITMQ_URL=amqp://<user>:<pass>@localhost:5672
NOTIFICATION_QUEUE=app_send_notification
ENABLE_SWAGGER=true

# Rate limit
RATE_LIMIT_MAX=500
RATE_LIMIT_TIME_WINDOW_MS=60000
RATE_LIMIT_ALLOW_LIST=127.0.0.1
